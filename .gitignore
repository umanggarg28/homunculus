.env
__pycache__/
*.pyc
.venv/
_events.jsonl
_events.jsonl.lock

# Personal build-from-scratch learning guide — kept local, not published.
LEARN.md

# Frontend dependencies and build output.
web/node_modules/
web/dist/
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# Runtime state — agent's working files and memory are user-specific.
workspace/*
!workspace/.gitkeep
workspace/tasks/
cache/
# Stray runtime state created when code runs outside the container with its
# default relative paths (./memory, ./tasks, ./proposals.json). The container
# sets working_dir to /app/workspace, so these resolve correctly there; run the
# same code from the repo root and it starts a second, empty store here.
# Real state lives under workspace/.
/memory/
/tasks/
/proposals.json
/proposals.json.lock

# Obsidian per-user state — if you open workspace/memory as a vault,
# Obsidian creates these. Already covered by `workspace/*` but listed
# here defensively in case the memory dir moves elsewhere.
.obsidian/
.obsidian-mobile/
*.obsidian-workspace

# Note: uv.lock IS committed — it pins exact dep versions for reproducible builds.
.playwright-mcp/
.DS_Store

# Coverage artifacts
.coverage
htmlcov/
secrets/
