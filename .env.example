# Required: API key used as the Authorization Bearer token. Provider-
# agnostic: paste whatever key matches HOMUNCULUS_API_URL below.
# For Groq (default): https://console.groq.com/keys
HOMUNCULUS_API_KEY=your_api_key_here

# Optional: override the model. Default is openai/gpt-oss-120b (best free
# tool-use model on Groq as of 2026). Other Groq options to try:
#   meta-llama/llama-4-scout-17b-16e-instruct  (10M context, fast)
#   llama-3.3-70b-versatile                    (older, sometimes flaky on tools)
#   openai/gpt-oss-20b                         (smaller, faster, less reliable)
# HOMUNCULUS_MODEL=openai/gpt-oss-120b

# Optional: override the API endpoint. Default is Groq's chat completions.
# To try a different OpenAI-compatible provider, point here. Examples:
#   https://generativelanguage.googleapis.com/v1beta/openai/chat/completions  (Gemini)
#   http://host.docker.internal:1234/v1/chat/completions                       (LM Studio)
#   http://host.docker.internal:11434/v1/chat/completions                      (Ollama)
# HOMUNCULUS_API_URL=https://api.groq.com/openai/v1/chat/completions

# Optional: fallback provider for 429s (rate limits). When the primary
# returns 429, we transparently try this provider's free tier so the
# user never sees the rate-limit error. Default points at Google's
# Gemini OpenAI-compatible endpoint — its free tier has 1M TPM (vs
# Groq's 8K), giving us large headroom on bursts.
#
# Get a free key at https://aistudio.google.com/apikey (no card required).
# Leave HOMUNCULUS_API_KEY_FALLBACK blank to disable fallback entirely.
# HOMUNCULUS_API_KEY_FALLBACK=
# HOMUNCULUS_API_URL_FALLBACK=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# HOMUNCULUS_MODEL_FALLBACK=gemini-2.0-flash

# Optional: heartbeat tick interval in minutes. Default 60. Lower values
# mean the daemon checks in more frequently but burns more API calls.
# HEARTBEAT_INTERVAL_MINUTES=60

# Optional: model for the heartbeat daemon. Defaults to openai/gpt-oss-20b
# (smaller, ~6x cheaper than the 120B used for REPL/Telegram). The
# heartbeat's job is simpler than full conversation, so the cheaper
# model is enough. Override here to use the strong model for heartbeat
# if you really want that.
# HOMUNCULUS_MODEL_HEARTBEAT=openai/gpt-oss-20b

# Web search (Phase 5.2) — required for the web_search() tool.
# Get a free key at https://tavily.com (1000 searches/month, no card).
TAVILY_API_KEY=

# Optional: pick a different search provider. Default: tavily.
# (No other providers implemented yet — placeholder for future.)
# WEB_SEARCH_PROVIDER=tavily

# Telegram bridge (Phase 4) — required for `docker compose up telegram`
# and for the heartbeat's notify() tool to work.
#
# 1. Open Telegram, search @BotFather, /newbot, get a token. Paste here:
TELEGRAM_BOT_TOKEN=

# 2. The bot is single-user — only YOU can talk to it. Leave this blank
#    on first run; start the bot, message it, it'll reply with your
#    numeric user ID. Paste that here and restart the bot.
TELEGRAM_ALLOWED_USER_ID=
