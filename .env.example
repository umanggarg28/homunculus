# Required: API key used as the Authorization Bearer token. Provider-
# agnostic: paste whatever key matches HOMUNCULUS_API_URL below.
# Default primary: OpenRouter (openai/gpt-oss-120b).
# Get key at https://openrouter.ai/keys
HOMUNCULUS_API_KEY=your_openrouter_key_here

# Optional: override the model. Default is openai/gpt-oss-120b on
# OpenRouter — the smartest and cheapest tool-calling model in the
# sub-$1/M tier per artificialanalysis.ai (Nov 2026):
#   Intelligence index 33 (vs Gemini 2.5 Flash 21, Haiku 4.5 31)
#   Blended price $0.20/M tokens
#   131K context (max we've ever sent is 31K, p99 is 21K — plenty)
# Other tested options:
#   gemini-2.5-flash                            (1M ctx, weaker on tool follow-through)
#   anthropic/claude-haiku-4-5                  (better but ~4x cost)
# HOMUNCULUS_MODEL=openai/gpt-oss-120b

# Optional: override the API endpoint. Default is OpenRouter's chat
# completions. To try a different OpenAI-compatible provider, point here.
#   https://generativelanguage.googleapis.com/v1beta/openai/chat/completions  (Gemini)
#   https://api.groq.com/openai/v1/chat/completions                            (Groq)
#   http://host.docker.internal:1234/v1/chat/completions                       (LM Studio)
#   http://host.docker.internal:11434/v1/chat/completions                      (Ollama)
# HOMUNCULUS_API_URL=https://openrouter.ai/api/v1/chat/completions

# Fallback provider chain — on 429 from one provider we route to the
# next; a 429'd provider is benched for 60s so we don't hammer it.
# Each slot is independent — fill in only the keys you have.
#
# Slot 1: Gemini (1M TPM free, but 15 RPM / 1500 RPD).
# Get key at https://aistudio.google.com/apikey
# HOMUNCULUS_API_KEY_FALLBACK=
# HOMUNCULUS_API_URL_FALLBACK=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# HOMUNCULUS_MODEL_FALLBACK=gemini-2.5-flash
#
# Slot 2: OpenRouter free-tier comma-separated chain (different rate-limit
# pool than the paid primary above, useful for transient 429s).
# Note: qwen/qwen3-coder:free is intentionally omitted — OpenRouter routes it
# to a deprecated Venice upstream that returns 404.
# HOMUNCULUS_API_KEY_FALLBACK_2=
# HOMUNCULUS_API_URL_FALLBACK_2=https://openrouter.ai/api/v1/chat/completions
# HOMUNCULUS_MODEL_FALLBACK_2=moonshotai/kimi-k2.6:free,openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free
#
# Slot 3: Cerebras (fast inference, generous TPM).
# Get key at https://cloud.cerebras.ai
# HOMUNCULUS_API_KEY_FALLBACK_3=
# HOMUNCULUS_API_URL_FALLBACK_3=https://api.cerebras.ai/v1/chat/completions
# HOMUNCULUS_MODEL_FALLBACK_3=llama-3.3-70b

# Optional but recommended: hard DAILY spend ceiling in USD for paid models.
# When today's estimated spend (from the events log) reaches this, paid
# models are skipped for the rest of the local day and the chain falls
# through to free routes. Unset or 0 = NO ceiling (a one-time warning is
# logged the first time a paid model runs without one). Paid models missing
# from llm.py's pricing table are costed at conservative frontier rates, so
# an unlisted model can't spend invisibly. ~$0.15/day ≈ a $5/month cap.
# HOMUNCULUS_DAILY_BUDGET_USD=0.15

# Optional: heartbeat tick interval in minutes. Default 60. Lower values
# mean the daemon checks in more frequently but burns more API calls.
# HEARTBEAT_INTERVAL_MINUTES=60

# Optional: structured task state directory. In Docker this resolves under
# /app/workspace, next to memory/. Heartbeat checks this before spending
# an LLM call.
# HOMUNCULUS_TASKS_DIR=./tasks

# Optional: cache directory for web_search/web_fetch tool results. In
# Docker this resolves under /app/workspace. TTL defaults to 24h.
# HOMUNCULUS_CACHE_DIR=./cache
# WEB_SEARCH_CACHE_SECONDS=86400
# WEB_FETCH_CACHE_SECONDS=86400

# Optional: model for the heartbeat daemon. Defaults to openai/gpt-oss-120b
# (same as primary). Override here to A/B test against a different model
# on the heartbeat path only.
# HOMUNCULUS_MODEL_HEARTBEAT=openai/gpt-oss-120b

# Optional: model for skill-refinement runs (rare, ~1 per skill per
# month when a procedure breaks). Defaults to anthropic/claude-haiku-4-5
# — stronger than the heartbeat model at API discovery and exploration,
# which the live LeetCode-skill refinement test on gpt-oss-120b showed
# was needed. Refinement cost: ~$0.05/run (Haiku) vs ~$0.012 (gpt-oss).
# Override here for one-off experiments (e.g. anthropic/claude-sonnet-4-6
# for harder refinements).
# HOMUNCULUS_MODEL_REFINEMENT=anthropic/claude-haiku-4-5

# Web search (Phase 5.2) — required for the web_search() tool.
# Get a free key at https://tavily.com (1000 searches/month, no card).
TAVILY_API_KEY=

# Optional: pick a different search provider. Default: tavily.
# (No other providers implemented yet — placeholder for future.)
# WEB_SEARCH_PROVIDER=tavily

# Optional: semantic memory recall. Without it, recall falls back to keyword
# search. This is a Google AI Studio key, NOT the OpenRouter key above — the
# embedding endpoint is Google's. Free tier: 1500 requests/day, no card.
# Get one at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# Optional: override the embedding model (default: gemini-embedding-001).
# HOMUNCULUS_EMBED_MODEL=gemini-embedding-001

# Optional: protect the web console/API with a shared token. Leave blank
# for frictionless localhost-only development. If set, the browser UI will
# ask for this token and API requests must send it.
# HOMUNCULUS_WEB_AUTH_TOKEN=

# Telegram bridge (Phase 4) — required for `docker compose up telegram`
# and for the heartbeat's notify() tool to work.
#
# 1. Open Telegram, search @BotFather, /newbot, get a token. Paste here:
TELEGRAM_BOT_TOKEN=

# 2. The bot is single-user — only YOU can talk to it. Leave this blank
#    on first run; start the bot, message it, it'll reply with your
#    numeric user ID. Paste that here and restart the bot.
TELEGRAM_ALLOWED_USER_ID=

# Discord bridge — an optional parallel chat channel (additive; runs alongside
# Telegram). A relay channel: outbound-only, works from a local deploy with no
# tunnel. notify() pushes to it when both vars below are set.
#
# 1. https://discord.com/developers/applications → New Application → Bot tab →
#    enable "MESSAGE CONTENT INTENT", copy the token:
DISCORD_BOT_TOKEN=
# 2. Single-user, like Telegram. Leave blank on first run; start the bot
#    (`docker compose up -d discord`), message it, and it replies with your
#    user ID + the channel ID to paste here, then restart.
DISCORD_ALLOWED_USER_ID=
DISCORD_CHANNEL_ID=

# Optional: your GitHub handle, for the weekly profile-health check
# (github_profile). Identity is configured, never guessed — leave blank
# and the check errors clearly instead of looking up a stranger.
HOMUNCULUS_GITHUB_USER=
