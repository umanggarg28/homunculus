# Required: API key used as the Authorization Bearer token. Provider-
# agnostic: paste whatever key matches HOMUNCULUS_API_URL below.
# For Groq (default): https://console.groq.com/keys
HOMUNCULUS_API_KEY=your_api_key_here

# Optional: override the model. Default is openai/gpt-oss-120b (best free
# tool-use model on Groq as of 2026). Other Groq options to try:
#   meta-llama/llama-4-scout-17b-16e-instruct  (10M context, fast)
#   llama-3.3-70b-versatile                    (older, sometimes flaky on tools)
#   openai/gpt-oss-20b                         (smaller, faster, less reliable)
# HOMUNCULUS_MODEL=openai/gpt-oss-120b

# Optional: override the API endpoint. Default is Groq's chat completions.
# To try a different OpenAI-compatible provider, point here. Examples:
#   https://generativelanguage.googleapis.com/v1beta/openai/chat/completions  (Gemini)
#   http://host.docker.internal:1234/v1/chat/completions                       (LM Studio)
#   http://host.docker.internal:11434/v1/chat/completions                      (Ollama)
# HOMUNCULUS_API_URL=https://api.groq.com/openai/v1/chat/completions
